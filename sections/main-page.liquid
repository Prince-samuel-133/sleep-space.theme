{% comment %}
  Sleep Space – main-page.liquid
  Drop into: Online Store > Themes > Edit Code > Templates > main-page.liquid
  All CSS lives in the <style> block below. No external dependencies.
{% endcomment %}

<style>
  /* ============================================================
     RESET & BASE
  ============================================================ */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --blue-light:   #8FD3FF;
    --blue-mid:     #5ABEFF;
    --blue-dark:    #1A7FC1;
    --blue-deep:    #0D4F7A;
    --white:        #FFFFFF;
    --off-white:    #F4FAFF;
    --text-dark:    #0D1A26;
    --text-mid:     #3D5A73;
    --text-soft:    #7A9BB5;
    --border:       rgba(143, 211, 255, 0.35);
    --shadow-sm:    0 2px 12px rgba(26, 127, 193, 0.10);
    --shadow-md:    0 8px 32px rgba(26, 127, 193, 0.15);
    --shadow-lg:    0 20px 60px rgba(26, 127, 193, 0.20);
    --radius-sm:    10px;
    --radius-md:    18px;
    --radius-lg:    28px;
    --radius-full:  999px;
    --font-display: 'Georgia', 'Times New Roman', serif;
    --font-body:    'Helvetica Neue', 'Arial', sans-serif;
    --transition:   0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    color: var(--text-dark);
    background: var(--white);
    line-height: 1.6;
    overflow-x: hidden;
  }

  img { max-width: 100%; display: block; }
  a   { text-decoration: none; color: inherit; }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ============================================================
     TYPOGRAPHY UTILITIES
  ============================================================ */
  .label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-dark);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-dark);
  }

  .section-sub {
    font-size: 17px;
    color: var(--text-mid);
    max-width: 560px;
    line-height: 1.7;
  }

  /* ============================================================
     BUTTONS
  ============================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-full);
    transition: var(--transition);
    padding: 15px 34px;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--blue-mid) 0%, var(--blue-dark) 100%);
    color: var(--white);
    box-shadow: 0 6px 24px rgba(26, 127, 193, 0.38);
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 36px rgba(26, 127, 193, 0.48);
    background: linear-gradient(135deg, var(--blue-light) 0%, var(--blue-mid) 100%);
    color: var(--text-dark);
  }

  .btn-outline {
    background: transparent;
    color: var(--blue-dark);
    border: 2px solid var(--blue-mid);
  }
  .btn-outline:hover {
    background: var(--blue-mid);
    color: var(--white);
    transform: translateY(-2px);
  }

  .btn-white {
    background: var(--white);
    color: var(--blue-dark);
    box-shadow: var(--shadow-md);
  }
  .btn-white:hover {
    background: var(--off-white);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .btn-cart {
    width: 100%;
    justify-content: center;
    background: linear-gradient(135deg, var(--blue-mid) 0%, var(--blue-dark) 100%);
    color: var(--white);
    font-size: 14px;
    padding: 13px 20px;
    box-shadow: 0 4px 16px rgba(26, 127, 193, 0.28);
  }
  .btn-cart:hover {
    background: linear-gradient(135deg, var(--blue-light) 0%, var(--blue-mid) 100%);
    color: var(--text-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26, 127, 193, 0.40);
  }

  /* ============================================================
     FREE SHIPPING BANNER
  ============================================================ */
  .banner-strip {
    background: linear-gradient(90deg, var(--blue-deep) 0%, var(--blue-dark) 50%, var(--blue-deep) 100%);
    color: var(--white);
    text-align: center;
    padding: 11px 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    position: relative;
    overflow: hidden;
  }
  .banner-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.06) 50%, transparent 100%);
    animation: shimmer 3s infinite;
  }
  @keyframes shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .banner-strip span { margin: 0 18px; opacity: 0.7; }

  /* ============================================================
     SITE HEADER
  ============================================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--blue-deep);
  }
  .logo-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--blue-light), var(--blue-mid));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-mid);
    transition: color var(--transition);
    letter-spacing: 0.02em;
  }
  .nav-links a:hover { color: var(--blue-dark); }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cart-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 8px 18px 8px 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark);
    cursor: pointer;
    transition: var(--transition);
  }
  .cart-btn:hover { background: var(--blue-light); }
  .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }

  /* ============================================================
     HERO SECTION
  ============================================================ */
  .hero {
    background: linear-gradient(160deg, #E8F7FF 0%, #C5EAFF 40%, #8FD3FF 100%);
    padding: 90px 24px 80px;
    overflow: hidden;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.55) 0%, transparent 70%);
    top: -200px;
    right: -150px;
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(90,190,255,0.25) 0%, transparent 70%);
    bottom: -100px;
    left: -80px;
    pointer-events: none;
  }
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .hero-content { position: relative; z-index: 1; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(90,190,255,0.45);
    border-radius: var(--radius-full);
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--blue-dark);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 28px;
    backdrop-filter: blur(8px);
  }
  .hero-badge-dot {
    width: 7px;
    height: 7px;
    background: var(--blue-mid);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%       { transform: scale(1.5); opacity: 0.6; }
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.08;
    color: var(--blue-deep);
    margin-bottom: 22px;
  }
  .hero-title em {
    font-style: italic;
    color: var(--blue-dark);
  }
  .hero-sub {
    font-size: 18px;
    color: var(--text-mid);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 440px;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 50px;
  }
  .hero-stats {
    display: flex;
    gap: 36px;
  }
  .hero-stat {}
  .hero-stat-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--blue-deep);
    line-height: 1;
  }
  .hero-stat-label {
    font-size: 12px;
    color: var(--text-mid);
    margin-top: 3px;
    font-weight: 500;
  }
  .hero-visual {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }
  .hero-product-card {
    background: rgba(255,255,255,0.80);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 380px;
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-14px); }
  }
  .hero-img-placeholder {
    background: linear-gradient(135deg, #DCF2FF 0%, #B8E4FF 100%);
    border-radius: var(--radius-md);
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    position: relative;
    overflow: hidden;
  }
  .hero-img-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.3) 0%, transparent 60%);
  }
  .product-icon-large {
    width: 100px;
    height: 100px;
    opacity: 0.85;
  }
  .hero-card-info { text-align: center; }
  .hero-card-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 6px;
  }
  .hero-card-desc {
    font-size: 14px;
    color: var(--text-mid);
    margin-bottom: 16px;
  }
  .hero-card-price {
    font-size: 26px;
    font-weight: 700;
    color: var(--blue-dark);
  }
  .hero-card-old {
    font-size: 16px;
    color: var(--text-soft);
    text-decoration: line-through;
    margin-right: 8px;
  }
  .floating-badge {
    position: absolute;
    top: -14px;
    right: -14px;
    background: linear-gradient(135deg, #FF6B6B, #FF4444);
    color: var(--white);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 7px 14px;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 14px rgba(255, 68, 68, 0.40);
    animation: bounce-badge 2.5s ease-in-out infinite;
  }
  @keyframes bounce-badge {
    0%, 100% { transform: rotate(-4deg) scale(1); }
    50%       { transform: rotate(4deg) scale(1.07); }
  }

  /* ============================================================
     BENEFITS
  ============================================================ */
  .benefits {
    padding: 100px 24px;
    background: var(--white);
  }
  .benefits-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .benefit-card {
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 36px 28px;
    transition: var(--transition);
    text-align: center;
  }
  .benefit-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-md);
    background: var(--white);
    border-color: var(--blue-light);
  }
  .benefit-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #DCF2FF, #B8E4FF);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
    transition: var(--transition);
  }
  .benefit-card:hover .benefit-icon {
    background: linear-gradient(135deg, var(--blue-light), var(--blue-mid));
  }
  .benefit-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 10px;
  }
  .benefit-desc {
    font-size: 14px;
    color: var(--text-mid);
    line-height: 1.7;
  }

  /* ============================================================
     PRODUCTS
  ============================================================ */
  .products {
    padding: 100px 24px;
    background: linear-gradient(180deg, #F4FAFF 0%, var(--white) 100%);
  }
  .products-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .product-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-lg);
    border-color: var(--blue-light);
  }
  .product-badge-wrap {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--radius-full);
  }
  .badge-bestseller { background: linear-gradient(135deg, #FFD700, #FFA500); color: #5A3A00; }
  .badge-bundle     { background: linear-gradient(135deg, #5ABEFF, #1A7FC1); color: #fff; }
  .badge-stock      { background: rgba(255,255,255,0.9); color: #C0392B; border: 1px solid #C0392B; }
  .product-img-wrap {
    background: linear-gradient(135deg, #EBF6FF 0%, #C8E9FF 100%);
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .product-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, transparent 100%);
  }
  .product-img-icon {
    width: 90px;
    height: 90px;
    opacity: 0.9;
    transition: transform var(--transition);
  }
  .product-card:hover .product-img-icon { transform: scale(1.10); }
  .product-body {
    padding: 26px 26px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .product-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 8px;
  }
  .product-desc {
    font-size: 14px;
    color: var(--text-mid);
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .product-features {
    list-style: none;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .product-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-mid);
    font-weight: 500;
  }
  .check-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    background: linear-gradient(135deg, var(--blue-light), var(--blue-mid));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 18px;
    margin-top: auto;
  }
  .price-current {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--blue-dark);
  }
  .price-old {
    font-size: 16px;
    color: var(--text-soft);
    text-decoration: line-through;
  }
  .price-save {
    font-size: 12px;
    font-weight: 700;
    background: #E8FFF0;
    color: #1A7A3A;
    padding: 3px 9px;
    border-radius: var(--radius-full);
  }
  .product-guarantee {
    text-align: center;
    font-size: 12px;
    color: var(--text-soft);
    margin-top: 10px;
  }

  /* ============================================================
     BUNDLE HIGHLIGHT
  ============================================================ */
  .bundle {
    padding: 100px 24px;
    background: linear-gradient(135deg, var(--blue-deep) 0%, #0F6599 50%, var(--blue-dark) 100%);
    position: relative;
    overflow: hidden;
  }
  .bundle::before {
    content: '';
    position: absolute;
    width: 800px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(143,211,255,0.15) 0%, transparent 70%);
    top: -300px;
    right: -200px;
  }
  .bundle::after {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
    bottom: -150px;
    left: -100px;
  }
  .bundle-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .bundle-label { color: var(--blue-light); margin-bottom: 16px; }
  .bundle-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 700;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .bundle-sub {
    font-size: 17px;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 36px;
  }
  .bundle-compare {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }
  .bundle-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: var(--radius-sm);
    padding: 14px 20px;
    backdrop-filter: blur(8px);
  }
  .bundle-item-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
  }
  .bundle-item-price {
    font-size: 15px;
    font-weight: 700;
    color: var(--blue-light);
  }
  .bundle-divider {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.2);
    margin: 4px 0;
  }
  .bundle-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 4px;
  }
  .bundle-total-label {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    text-decoration: line-through;
  }
  .bundle-total-save {
    font-size: 14px;
    font-weight: 800;
    color: #7DFFB4;
    background: rgba(125,255,180,0.15);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }
  .bundle-price-display {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: var(--radius-md);
    padding: 28px;
    backdrop-filter: blur(10px);
    text-align: center;
  }
  .bundle-big-price {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 700;
    color: var(--white);
    line-height: 1;
    margin-bottom: 6px;
  }
  .bundle-big-old {
    font-size: 22px;
    color: rgba(255,255,255,0.45);
    text-decoration: line-through;
    margin-bottom: 14px;
  }
  .bundle-savings-badge {
    display: inline-block;
    background: linear-gradient(135deg, #7DFFB4, #3DDC84);
    color: #0D4F2A;
    font-size: 14px;
    font-weight: 800;
    padding: 8px 22px;
    border-radius: var(--radius-full);
    margin-bottom: 24px;
  }
  .bundle-stars {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-bottom: 6px;
  }
  .bundle-review-count {
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    margin-bottom: 22px;
  }

  /* ============================================================
     REVIEWS
  ============================================================ */
  .reviews {
    padding: 100px 24px;
    background: var(--white);
  }
  .reviews-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .overall-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }
