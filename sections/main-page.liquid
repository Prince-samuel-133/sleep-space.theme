<section class="products" id="products">
  <div class="container">
    <div class="products-header reveal">
      <p class="label">Our Products</p>
      <h2 class="section-title" style="margin: 12px auto 16px; text-align: center;">
        Premium Sleep Solutions
      </h2>
      <p class="section-sub" style="margin: 0 auto; text-align: center;">
        Thoughtfully designed for everyone who deserves a better night's sleep.
      </p>
    </div>
    <div class="products-grid">

      {%- comment -%}
        Live Liquid loop — pulls every product from collections.all.
        Uses the modern image_url filter (img_url is deprecated in Shopify 2.0+).
        Add-to-cart uses fetch('/cart/add.js') so the page stays in place;
        on success it redirects to /cart.
      {%- endcomment -%}
      {% assign delay_classes = "reveal-delay-1,reveal-delay-2,reveal-delay-3" | split: "," %}  

      {%- for product in collections.all.products -%}
        {% assign delay_index = forloop.index0 | modulo: 3 %}
        {% assign delay = delay_classes[delay_index] %}
        {%- assign variant = product.selected_or_first_available_variant -%}
        {%- assign has_compare = false -%}
        {%- if variant.compare_at_price > variant.price -%}
          {%- assign has_compare = true -%}
          {%- assign savings = variant.compare_at_price | minus: variant.price -%}
        {%- endif -%}

        <div class="product-card reveal {{ delay }}">

          {%- comment -%} Badge row — first product gets Best Seller; last gets Best Value {%- endcomment -%}
          <div class="product-badge-wrap">
            {%- if forloop.first -%}
              <span class="badge badge-bestseller">⭐ Best Seller</span>
            {%- elsif forloop.last -%}
