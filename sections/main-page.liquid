  ============================================================ */
  .trust {
    padding: 72px 24px;
    background: var(--off-white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .trust-icon-wrap {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #DCF2FF, #B8E4FF);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .trust-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-dark);
  }
  .trust-desc {
    font-size: 13px;
    color: var(--text-mid);
    line-height: 1.6;
  }

  /* ============================================================
     FAQ
  ============================================================ */
  .faq {
    padding: 100px 24px;
    background: var(--white);
  }
  .faq-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition);
  }
  .faq-item.open { border-color: var(--blue-mid); box-shadow: var(--shadow-sm); }
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 26px;
    cursor: pointer;
    background: var(--off-white);
    transition: background var(--transition);
    user-select: none;
  }
  .faq-item.open .faq-question { background: #EBF6FF; }
  .faq-question-text {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-dark);
  }
  .faq-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    background: linear-gradient(135deg, var(--blue-light), var(--blue-mid));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition);
  }
  .faq-item.open .faq-icon { transform: rotate(45deg); }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s;
    padding: 0 26px;
    font-size: 15px;
    color: var(--text-mid);
    line-height: 1.75;
  }
  .faq-item.open .faq-answer {
    max-height: 300px;
    padding: 4px 26px 22px;
  }

  /* ============================================================
     URGENCY SECTION
  ============================================================ */
  .urgency {
    padding: 60px 24px;
    background: linear-gradient(90deg, #FFF8E8 0%, #FFF3D0 100%);
    border-top: 2px solid #FFD97A;
    border-bottom: 2px solid #FFD97A;
    text-align: center;
  }
  .urgency-inner { max-width: 680px; margin: 0 auto; }
  .urgency-icon { font-size: 36px; margin-bottom: 12px; }
  .urgency-title {
