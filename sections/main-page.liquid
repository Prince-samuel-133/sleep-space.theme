/* --- Add to Cart (fetch API) --- */
function addToCart(btn) {
  var variantId = parseInt(btn.getAttribute('data-variant-id'), 10);
  var originalHTML = btn.innerHTML;

  btn.disabled = true;
  btn.innerHTML = 'Adding&hellip;';

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(function(r) {
    if (r.ok) {
      window.location.href = '/cart';
    } else {
      return r.json().then(function(data) {
        alert(data.description || 'Could not add to cart. Please try again.');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      });
    }
  })
  .catch(function() {
    alert('Network error. Please check your connection and try again.');
    btn.disabled = false;
    btn.innerHTML = originalHTML;
  });
}

/* --- FAQ accordion --- */
function toggleFAQ(el) {
  var isOpen = el.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(function(i){ i.classList.remove('open'); });
  if (!isOpen) el.classList.add('open');
}

/* --- Scroll reveal --- */
(function() {
  var reveals = document.querySelectorAll('.reveal');
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  reveals.forEach(function(el) { observer.observe(el); });
})();

/* --- Countdown timer --- */
(function() {
  var end = new Date();
  end.setHours(end.getHours() + 8, end.getMinutes() + 47, end.getSeconds() + 22, 0);

  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function tick() {
    var now  = new Date();
    var diff = Math.max(0, Math.floor((end - now) / 1000));
    var h = Math.floor(diff / 3600);
    var m = Math.floor((diff % 3600) / 60);
    var s = diff % 60;
    var hEl = document.getElementById('hours');
    var mEl = document.getElementById('mins');
    var sEl = document.getElementById('secs');
    if (hEl) hEl.textContent = pad(h);
    if (mEl) mEl.textContent = pad(m);
    if (sEl) sEl.textContent = pad(s);
    if (diff > 0) setTimeout(tick, 1000);
  }
  tick();
})();
</script>