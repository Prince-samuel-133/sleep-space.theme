              <svg class="product-img-icon" viewBox="0 0 90 90" fill="none">
                <rect x="15" y="15" width="60" height="60" rx="12" fill="#C8E9FF"/>
                <path d="M35 45h20M45 35v20" stroke="#5ABEFF" stroke-width="3" stroke-linecap="round"/>
                <circle cx="45" cy="45" r="28" stroke="#8FD3FF" stroke-width="2" stroke-dasharray="4 4"/>
              </svg>
            {%- endif -%}
          </a>

          <div class="product-body">

            {%- comment -%} Title linked to product page {%- endcomment -%}
            <h3 class="product-name">
              <a href="{{ product.url }}" style="color:inherit;">{{ product.title }}</a>
            </h3>

            <p class="product-desc">{{ product.description | strip_html | truncate: 120 }}</p>

            {%- comment -%} Up to 3 bullet points from product metafields or tags {%- endcomment -%}
            {%- if product.tags.size > 0 -%}
              <ul class="product-features">
                {%- for tag in product.tags limit: 3 -%}
                  <li>
                    <span class="check-icon">
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    {{ tag }}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- comment -%} Price row {%- endcomment -%}
            <div class="product-price-row">
              <span class="price-current">{{ variant.price | money }}</span>
              {%- if has_compare -%}
                <span class="price-old">{{ variant.compare_at_price | money }}</span>
                <span class="price-save">Save {{ savings | money }}</span>
              {%- endif -%}
            </div>

            {%- comment -%}
              Add to Cart button.
              data-variant-id passes the first available variant ID to the JS handler.
              If the product is unavailable the button is disabled.
            {%- endcomment -%}
            {%- if variant.available -%}
              <button
                class="btn btn-cart"
                data-variant-id="{{ variant.id }}"
                onclick="addToCart(this)"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 2H3.4L5.6 10H12L14 5H4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="13" r="1" fill="currentColor"/><circle cx="11" cy="13" r="1" fill="currentColor"/></svg>
                Add to Cart
              </button>
            {%- else -%}
              <button class="btn btn-cart" disabled style="opacity:0.5; cursor:not-allowed;">
                Sold Out
              </button>
            {%- endif -%}

            <p class="product-guarantee">🔒 30-day money-back guarantee</p>
          </div>
        </div>

      {%- else -%}
        {%- comment -%} Shown only if the store has zero products — useful during setup {%- endcomment -%}
        <p style="grid-column:1/-1; text-align:center; color:var(--text-soft); padding:60px 0;">
          No products found. Add products to your Shopify store and they will appear here automatically.
        </p>
