          {%- comment -%} Product image — links to product page {%- endcomment -%}
          <a href="{{ product.url }}" class="product-img-wrap" style="display:flex; align-items:center; justify-content:center;">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
                width="800"
                height="800"
                loading="lazy"
