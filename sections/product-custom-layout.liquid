<!-- main-product.liquid or custom section -->

<div class="sleep-product-page">
  
  {% if product.handle == 'migraine-cap' %}
    <!-- Migraine Cap: Image Left, Text Right -->
    <div class="product-grid">
      <div class="product-image">
        <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
      </div>
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        {{ product.description }}
        <form action="/cart/add" method="post">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit">Add to Cart</button>
        </form>
      </div>
    </div>

  {% elsif product.handle == 'sleep-speaker' %}
    <!-- Sleep Speaker: Image Right, Text Left -->
    <div class="product-grid reverse">
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        {{ product.description }}
        <form action="/cart/add" method="post">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit">Add to Cart</button>
        </form>
      </div>
      <div class="product-image">
        <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
      </div>
    </div>

  {% elsif product.handle == 'sleep-kit' or product.handle contains 'combo' %}
    <!-- Combo Kit: Image Left, Text Right -->
    <div class="product-grid">
      <div class="product-image">
        <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
      </div>
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        <span class="badge">Best Value</span>
        {{ product.description }}
        <form action="/cart/add" method="post">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit">Add Kit to Cart</button>
        </form>
      </div>
    </div>
  {% endif %}

</div>