{% comment %}
  Cart section - fixed checkout version
{% endcomment %}

<h1>Your Cart</h1>

{% if cart.item_count == 0 %}
  <p>
    Your cart is empty.
    <a href="{{ routes.all_products_collection_url }}">Continue shopping</a>
  </p>
{% else %}

<form action="{{ routes.cart_url }}" method="post">
    <table>
      {% for item in cart.items %}
        <tr>
          <td>
            {% if item.image %}
              <td>
  {% if item.product.featured_image %}
    <a href="{{ item.url }}">
      <img
        src="{{ item.product.featured_image | image_url: width: 100 }}"
        alt="{{ item.product.title | escape }}"
        width="100"
        height="100"
        loading="lazy">
    </a>
  {% endif %}
</td>
            {% endif %}
          </td>
          <td>
            <p><a href="{{ item.url }}">{{ item.product.title }}</a></p>
            <p>{{ item.variant.title }}</p>
            <a href="{{ item.url_to_remove }}">Remove</a>
          </td>
          <td>
            <input
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
            >
          </td>
          <td>
            <p>{{ item.final_line_price | money }}</p>
          </td>
        </tr>
      {% endfor %}
    </table>

    <p><strong>Total: {{ cart.total_price | money }}</strong></p>

    <button type="submit" name="update">Update Cart</button>

    <button type="submit" name="checkout">
      Proceed to Checkout
    </button>

  </form>

{% endif %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
