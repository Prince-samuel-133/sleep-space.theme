{% comment %}
  Cart section - fully styled light blue & white theme
{% endcomment %}

<div class="cart-wrapper">
  <h1 class="cart-title">Your Cart</h1>

  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <p>Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-continue">
  Continue Shopping
</a>
    </div>
  {% else %}

    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-image">
             {% if item.product.featured_image %}
             <a href="{{ item.url }}">
               <img
                src="{{ item.product.featured_image | image_url: width: 200 }}"
                alt="{{ item.product.title | escape }}"
                width="200"
                height="200"
               loading="lazy">
            </a>
{% endif %}
            </div>

            <div class="cart-item-details">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-item-variant">{{ item.variant.title }}</p>
              {% endunless %}
              <p class="cart-item-price">{{ item.final_line_price | money }}</p>
              <a href="{{ item.url_to_remove }}" class="cart-item-remove">Remove</a>
            </div>

            <div class="cart-item-quantity">
              <label>Qty</label>
              <input
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                class="qty-input"
              >
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-summary">
        <div class="cart-total">
          <span>Total</span>
          <span class="total-price">{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-note">Shipping & taxes calculated at checkout</p>
        <button type="submit" name="update" class="btn-update">Update Cart</button>
        <button type="submit" name="checkout" class="btn-checkout">Proceed to Checkout →</button>
        <a href="{{ routes.all_products_collection_url }}" class="btn-continue">
  Continue Shopping
</a>
      </div>
    </form>

  {% endif %}
</div>

<style>
  .cart-wrapper {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: sans-serif;
  }

  .cart-title {
    font-size: 2rem;
    color: #1a3c5e;
    margin-bottom: 30px;
    border-bottom: 2px solid #b3d4f0;
    padding-bottom: 10px;
  }

  .cart-empty {
    text-align: center;
    padding: 60px 20px;
    color: #555;
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 30px;
  }

  .cart-item {
    display: flex;
    align-items: center;
    gap: 20px;
    background: #f0f8ff;
    border: 1px solid #b3d4f0;
    border-radius: 12px;
    padding: 20px;
  }

  .cart-item-image img {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #b3d4f0;
  }

  .cart-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cart-item-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a3c5e;
    text-decoration: none;
  }

  .cart-item-title:hover {
    text-decoration: underline;
  }

  .cart-item-variant {
    color: #666;
    font-size: 0.9rem;
  }

  .cart-item-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a3c5e;
  }

  .cart-item-remove {
    color: #e05555;
    font-size: 0.85rem;
    text-decoration: none;
    width: fit-content;
  }

  .cart-item-remove:hover {
    text-decoration: underline;
  }

  .cart-item-quantity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .cart-item-quantity label {
    font-size: 0.85rem;
    color: #555;
  }

  .qty-input {
    width: 60px;
    padding: 8px;
    border: 1px solid #b3d4f0;
    border-radius: 8px;
    text-align: center;
    font-size: 1rem;
    background: white;
  }

  .cart-summary {
    background: #f0f8ff;
    border: 1px solid #b3d4f0;
    border-radius: 12px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a3c5e;
    border-bottom: 1px solid #b3d4f0;
    padding-bottom: 16px;
  }

  .cart-note {
    color: #666;
    font-size: 0.85rem;
    text-align: center;
  }

  .btn-checkout {
    background: #1a3c5e;
    color: white;
    border: none;
    padding: 16px 32px;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    transition: background 0.2s;
  }

  .btn-checkout:hover {
    background: #0f2a45;
  }

  .btn-update {
    background: white;
    color: #1a3c5e;
    border: 2px solid #1a3c5e;
    padding: 12px 32px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    transition: all 0.2s;
  }

  .btn-update:hover {
    background: #e8f4fd;
  }

  .btn-continue {
    display: block;
    text-align: center;
    color: #1a3c5e;
    text-decoration: none;
    font-size: 0.95rem;
    padding: 8px;
  }

  .btn-continue:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .cart-item {
      flex-direction: column;
      align-items: flex-start;
    }

    .cart-item-image img {
      width: 100%;
      height: auto;
    }
  }
</style>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
