<div class="sleep-product">

  {% if product.handle == 'migraine-cap' %}
    <!-- Migraine Cap - Image Left, Text Right -->
    <div class="product-grid">
      <div class="product-image">
        <img src="{{ product.featured_image | img_url: '1200x' }}" alt="Migraine Cap">
      </div>
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        {{ product.description }}
        <button type="submit" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Migraine Cap to Cart
        </button>
      </div>
    </div>

  {% elsif product.handle == 'sleep-speaker' %}
    <!-- Sleep Speaker - Image Right, Text Left -->
    <div class="product-grid reverse">
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        {{ product.description }}
        <button type="submit" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Sleep Speaker to Cart
        </button>
      </div>
      <div class="product-image">
        <img src="{{ product.featured_image | img_url: '1200x' }}" alt="Sleep Speaker">
      </div>
    </div>

  {% else %}
    <!-- Combo Kit - Image Left, Text Right -->
    <div class="product-grid">
      <div class="product-image">
        <img src="{{ product.featured_image | img_url: '1200x' }}" alt="Sleep Space Kit">
      </div>
      <div class="product-info">
        <span class="badge">Best Value • Save Money</span>
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.price | money }}</p>
        {{ product.description }}
        <button type="submit" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Complete Sleep Kit
        </button>
      </div>
    </div>
  {% endif %}

</div>

<script>
function addToCart(variantId) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  }).then(() => {
    window.location.href = '/cart';
  });
}
</script>