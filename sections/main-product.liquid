<div class="sleep-product">

  {% if product.handle == 'retractable-ice-gel-headache-relief-cap' %}
    <div class="product-grid">
      <div class="product-image">
        {% if product.featured_image %}
      {% if product.featured_image %}
  <img
    src="{{ product.featured_image | image_url: width: 1200 }}"
    alt="{{ product.title | escape }}"
    width="1200"
    height="1200">
{% endif %}
        {% endif %}
      </div>
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.selected_or_first_available_variant.price | money }}</p>
        <div class="description">{{ product.description }}</div>
        <button type="button" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Migraine Cap to Cart
        </button>
      </div>
    </div>

  {% elsif product.handle == 'creative-mini-ultra-thin-sleep-inducing-bluetooth-speaker' %}
    <div class="product-grid reverse">
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.selected_or_first_available_variant.price | money }}</p>
        <div class="description">{{ product.description }}</div>
        <button type="button" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Sleep Speaker to Cart
        </button>
      </div>
      <div class="product-image">
        {% if product.featured_image %}
         {% if product.featured_image %}
  <img
    src="{{ product.featured_image | image_url: width: 1200 }}"
    alt="{{ product.title | escape }}"
    width="1200"
    height="1200">
{% endif %}
        {% endif %}
      </div>
    </div>

  {% else %}
    <div class="product-grid">
      <div class="product-image">
        {% if product.featured_image %}
          {% if product.featured_image %}
  <img
    src="{{ product.featured_image | image_url: width: 1200 }}"
    alt="{{ product.title | escape }}"
    width="1200"
    height="1200">
{% endif %}
        {% endif %}
      </div>
      <div class="product-info">
        <span class="badge">Best Value • Save Money</span>
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.selected_or_first_available_variant.price | money }}</p>
        <div class="description">{{ product.description }}</div>
        <button type="button" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Complete Sleep Kit
        </button>
      </div>
    </div>
  {% endif %}

</div>

<style>
  .sleep-product {
    max-width: 1100px;
    margin: 60px auto;
    padding: 0 24px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: #f0f8ff;
    border: 1px solid #b3d4f0;
    border-radius: 20px;
    padding: 50px;
  }

  .product-grid.reverse {
    direction: rtl;
  }

  .product-grid.reverse > * {
    direction: ltr;
  }

  /* Image */
  .product-image {
    width: 100%;
  }

  .product-image img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0, 100, 200, 0.12);
    display: block;
  }

  /* Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .product-info h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #1a3c5e;
    margin: 0;
    line-height: 1.3;
  }

  .price {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1a7abf;
    margin: 0;
  }

  /* Description */
  .description {
    color: #4a5568;
    font-size: 0.95rem;
    line-height: 1.8;
    border-top: 1px solid #b3d4f0;
    padding-top: 16px;
  }

  .description p {
    margin: 0 0 10px 0;
  }

  .description b, .description strong {
    color: #1a3c5e;
  }

  .description img {
    display: none;
  }

  /* Badge */
  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #1a7abf, #1a3c5e);
    color: white;
    padding: 8px 18px;
    border-radius: 25px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    width: fit-content;
  }

  /* Button */
  .add-to-cart {
    background: #1a3c5e;
    color: white;
    border: none;
    padding: 18px 32px;
    border-radius: 10px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    letter-spacing: 0.3px;
    margin-top: 8px;
  }

  .add-to-cart:hover {
    background: #0f2a45;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(26, 60, 94, 0.3);
  }

  .add-to-cart:active {
    transform: translateY(0);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr;
      direction: ltr !important;
      padding: 28px;
      gap: 28px;
    }

    .product-image img {
      height: 300px;
    }

    .product-info h1 {
      font-size: 1.5rem;
    }

    .price {
      font-size: 1.4rem;
    }
  }

  /* ===== SLEEP SPACE — Product Page CSS (Corrected) ===== */

/* --- Page Background --- */
body {
  background-color: #f0f6fb;
}

/* --- Product Images --- */
.product-images {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  padding: 1.5rem;
}

.product-image {
  border-radius: 12px;
  box-shadow: 0 8px 30px rgba(58, 107, 138, 0.15);
  max-width: 100%;
}

/* --- Product Info --- */
.product-info {
  padding: 1.5rem;
}

.product-info h1 {
  font-size: 2.2rem;
  font-weight: 700;
  color: #1a2e3b;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 0.5rem;
}

.product-info p:first-of-type {
  font-size: 1.6rem;
  font-weight: 600;
  color: #3a6b8a;
  margin-bottom: 1rem;
}

.product-info p:last-of-type {
  font-size: 1rem;
  color: #4a5568;
  line-height: 1.8;
}

/* --- Product Form --- */
.product-form {
  padding: 1.5rem;
}

.product-form select {
  width: 100%;
  padding: 12px;
  border: 2px solid #3a6b8a;
  border-radius: 8px;
  color: #1a2e3b;
  font-size: 1rem;
  margin-bottom: 1rem;
  background-color: #ffffff;
}

.product-form input[type="text"] {
  width: 80px;
  padding: 10px;
  border: 2px solid #d0e4f0;
  border-radius: 8px;
  font-size: 1rem;
  margin-bottom: 1rem;
}

/* --- Add to Cart Button --- */
.product-form input[type="submit"] {
  display: block;
  width: 100%;
  background-color: #3a6b8a;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 16px 32px;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.2s ease;
  margin-bottom: 1rem;
}

.product-form input[type="submit"]:hover {
  background-color: #2a5070;
  transform: translateY(-2px);
}

</style>

<script>
function addToCart(variantId) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(response => {
    if (response.ok) {
      window.location.href = '/cart';
    } else {
      return response.json().then(data => {
        alert('Could not add to cart: ' + (data.description || 'Please try again.'));
      });
    }
  })
  .catch(() => {
    alert('Something went wrong. Please try again.');
  });
}
</script>
