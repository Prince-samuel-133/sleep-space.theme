<div class="sleep-product">

  {% if product.handle == 'retractable-ice-gel-headache-relief-cap' %}
    <!-- Migraine Cap - Image Left, Text Right -->
    <div class="product-grid">
      <div class="product-image">
        {% if product.featured_image %}
  <img
    src="{{ product.featured_image | image_url: width: 1200 }}"
    alt="{{ product.title | escape }}"
    width="1200"
    height="1200">
{% endif %}
      </div>
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.selected_or_first_available_variant.price | money }}</p>
        {{ product.description }}
        <button type="button" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Migraine Cap to Cart
        </button>
      </div>
    </div>

  {% elsif product.handle == 'creative-mini-ultra-thin-sleep-inducing-bluetooth-speaker' %}
    <!-- Sleep Speaker - Image Right, Text Left -->
    <div class="product-grid reverse">
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.selected_or_first_available_variant.price | money }}</p>
        {{ product.description }}
        <button type="button" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Sleep Speaker to Cart
        </button>
      </div>
      <div class="product-image">
        
      </div>
    </div>

  {% else %}
    <!-- Full Recovery Kit - Image Left, Text Right -->
    <div class="product-grid">
      <div class="product-image">
        {% if product.featured_image %}
  <img
    src="{{ product.featured_image | image_url: width: 1200 }}"
    alt="{{ product.title | escape }}"
    width="1200"
    height="1200">
{% endif %}
      </div>
      <div class="product-info">
        <span class="badge">Best Value • Save Money</span>
        <h1>{{ product.title }}</h1>
        <p class="price">{{ product.selected_or_first_available_variant.price | money }}</p>
        {{ product.description }}
        <button type="button" class="add-to-cart" onclick="addToCart({{ product.variants.first.id }})">
          Add Complete Sleep Kit
        </button>
      </div>
    </div>
  {% endif %}

</div>

<script>
function addToCart(variantId) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(response => {
    if (response.ok) {
      window.location.href = '/cart';
    } else {
      return response.json().then(data => {
        alert('Could not add to cart: ' + (data.description || 'Please try again.'));
      });
    }
  })
  .catch(() => {
    alert('Something went wrong. Please try again.');
  });
}
</script>
