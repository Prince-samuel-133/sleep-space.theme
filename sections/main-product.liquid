<div class="sleep-product">

  {% assign current_variant = product.selected_or_first_available_variant %}

  {% if product.handle == 'migraine-cap' %}

    <div class="product-grid">
      <div class="product-image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
            width="1200"
            height="1200">
        {% endif %}
      </div>

      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ current_variant.price | money }}</p>
        <div>{{ product.description }}</div>

        <button
          type="button"
          class="add-to-cart"
          onclick="addToCart({{ current_variant.id }})">
          Add Migraine Cap to Cart
        </button>
      </div>
    </div>

  {% elsif product.handle == 'sleep-speaker' %}

    <div class="product-grid reverse">
      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <p class="price">{{ current_variant.price | money }}</p>
        <div>{{ product.description }}</div>

        <button
          type="button"
          class="add-to-cart"
          onclick="addToCart({{ current_variant.id }})">
          Add Sleep Speaker to Cart
        </button>
      </div>

      <div class="product-image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
            width="1200"
            height="1200">
        {% endif %}
      </div>
    </div>

  {% else %}

    <div class="product-grid">
      <div class="product-image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
            width="1200"
            height="1200">
        {% endif %}
      </div>

      <div class="product-info">
        <span class="badge">Best Value • Save Money</span>
        <h1>{{ product.title }}</h1>
        <p class="price">{{ current_variant.price | money }}</p>
        <div>{{ product.description }}</div>

        <button
          type="button"
          class="add-to-cart"
          onclick="addToCart({{ current_variant.id }})">
          Add Complete Sleep Kit
        </button>
      </div>
    </div>

  {% endif %}

</div>